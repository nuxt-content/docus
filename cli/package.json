{
  "name": "create-docus",
  "description": "CLI for creating Docus documentation projects",
  "version": "5.12.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt-content/docus.git"
  },
  "private": false,
  "license": "MIT",
  "bin": {
    "create-docus": "dist/main.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsup-node ./main.ts --format esm",
    "dev": "tsx ./main.ts"
  },
  "dependencies": {
    "@nuxt/cli": "3.36.1",
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12"
  },
  "packageManager": "pnpm@11.22.0"
}
